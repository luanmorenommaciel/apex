# Apex infra · copy to .env and adjust.  DO NOT commit a real .env (gitignored).
#
#   cp .env.example .env
#   # then set BOTH credentials (the stack refuses to start without them, and refuses defaults):
#   #   CLICKHOUSE_PASSWORD=$(openssl rand -hex 24)
#   #   HYPERDX_API_KEY=$(openssl rand -hex 32)
#   make up          # = scripts/preflight.sh + docker compose up -d --wait
#
# --- Bind address: loopback unless you deliberately expose the stack ---
# Other lanes reach infra over the Docker network by container name; host ports are for
# humans and tools on this machine. Set 0.0.0.0 only on a host you mean to expose.
BIND_HOST=127.0.0.1
#
# --- Host port bindings (CONTRACT.md Port Map — infra's reserved band) ---
# Container-internal ports stay standard; only the host mapping is overridable here.
# ⚠️ HOST HYGIENE: on a shared dev host a stray oteru-collector may squat 8123/9000/4318 and
#    collect runs on 18123/19000/14318. If `up` hits a bind conflict, shift the CH + collector
#    host ports here (see the commented shifted band below) — do NOT touch the stray stack.
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9000
MONGO_HOST_PORT=27017
OTLP_HTTP_HOST_PORT=4318
OTLP_GRPC_HOST_PORT=4317
COLLECTOR_HEALTH_HOST_PORT=13133

# HyperDX — UI 8090 (Port Map; NOT 8080, dev's Spark master owns it), OpAMP 4320.
# API 8000 is HyperDX's internal API port (browser reaches it via NEXT_PUBLIC_SERVER_URL).
HYPERDX_APP_HOST_PORT=8090
HYPERDX_APP_PORT=8090
HYPERDX_API_HOST_PORT=8000
HYPERDX_API_PORT=8000
HYPERDX_OPAMP_HOST_PORT=4320
HYPERDX_OPAMP_PORT=4320

# --- Shifted band for THIS dev host (uncomment to dodge the oteru squatter) ---
# CLICKHOUSE_HTTP_HOST_PORT=28123
# CLICKHOUSE_NATIVE_HOST_PORT=29000
# OTLP_HTTP_HOST_PORT=24318
# OTLP_GRPC_HOST_PORT=24317
# COLLECTOR_HEALTH_HOST_PORT=24133

# --- ClickHouse ---
CLICKHOUSE_USER=apex
# REQUIRED, no default:  openssl rand -hex 24
# preflight writes it to secrets/clickhouse_password (gitignored); the containers read that
# FILE, so the password never appears in `docker inspect`. HyperDX gets its own read-only
# user (apex_hdx, secrets/hyperdx_clickhouse_password), never this one.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=apex

# --- Images (pinned by digest in docker-compose.yml) ---
# Every image is `repo:tag@sha256:...`. To bump one, change the tag AND the digest together;
# resolve a digest with:  docker buildx imagetools inspect repo:tag | grep '^Digest'
# HyperDX is the only one overridable from here (tag + digest must move as a pair):
HDX_IMAGE_VERSION=2.43.1
HDX_IMAGE_DIGEST=sha256:a9db02b18730846726979a8a948f8439b21988f46a319a9114eae62e136414d9
# Pinned in the compose file itself: clickhouse-server 24.8.14.39, mongo 5.0.32-focal (the 5.0
# line HyperDX ships), otel collector-contrib 0.156.0, busybox 1.36.

# --- Memory limits (docker compose honours deploy.resources.limits outside swarm) ---
# The root README asks for 8 GB+ for the full pipeline; these keep one runaway container
# from taking the stack down. Raise them on a bigger host.
CLICKHOUSE_MEM_LIMIT=4g
MONGO_MEM_LIMIT=1g
HYPERDX_MEM_LIMIT=2g
COLLECTOR_MEM_LIMIT=2560m

# --- HyperDX ---
HYPERDX_LOG_LEVEL=info
USAGE_STATS_ENABLED=false
# REQUIRED, 64 hex characters, no default:  openssl rand -hex 32
HYPERDX_API_KEY=
# First HyperDX user, registered by scripts/hyperdx_bootstrap.sh (make up / make bootstrap)
# through the API — creating the team is what seeds the ClickHouse connection and the
# Spark Events source. Any email; password 12+ characters. No default.
HYPERDX_ADMIN_EMAIL=
HYPERDX_ADMIN_PASSWORD=
