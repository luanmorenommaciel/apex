# Apex — Lane 3 (collect) · copy to .env and adjust.  DO NOT commit a real .env.

# --- Host port bindings (CONTRACT.md Port Map — collect's reserved band) ---
# Container-internal ports stay standard; only the host mapping is overridable here.
OTLP_HTTP_HOST_PORT=4318
OTLP_GRPC_HOST_PORT=4317
HEALTHCHECK_HOST_PORT=13133

# --- ClickHouse (LOCAL test instance only) ---
# In this lane we run a throwaway ClickHouse to test against. When the infra/ lane
# lands, drop this container and point the exporter at infra's clickhouse:9000 on the
# shared docker network instead. Host ports below are for a human/tool reaching in;
# the collector talks to clickhouse over the internal network (clickhouse:9000).
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9000
CLICKHOUSE_USER=apex
CLICKHOUSE_PASSWORD=apex_local_dev
CLICKHOUSE_DB=apex

# --- Redaction ---
# Keyed HMAC secret for the redaction/pii processor (low-entropy email/IP masking).
# Generate a real one:  openssl rand -hex 32
REDACTION_SECRET_KEY=change-me-openssl-rand-hex-32
