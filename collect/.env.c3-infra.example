# Non-secret host-port overrides for the C3 integration overlay.
# The normal collect band is occupied by infra during the full tracer bullet.
CLICKHOUSE_HTTP_HOST_PORT=18123
CLICKHOUSE_NATIVE_HOST_PORT=19000
OTLP_HTTP_HOST_PORT=14318
OTLP_GRPC_HOST_PORT=14317
HEALTHCHECK_HOST_PORT=11313

# Smoke-only HMAC key: satisfies the collector's minimum-length validation.
# Replace it with an operator-provided secret in any non-local deployment.
REDACTION_SECRET_KEY=local-c3-smoke-only-not-a-production-secret-0123456789abcdef
