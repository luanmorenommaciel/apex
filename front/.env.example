# ClickHouse HTTP interface. In dev the Vite proxy fronts this at /clickhouse
# so the browser never needs a CORS header from the database.
VITE_CLICKHOUSE_URL=http://127.0.0.1:8123
VITE_CLICKHOUSE_DB=apex

# Use a READ-ONLY ClickHouse user. See README — "Querying ClickHouse from the
# browser" — for why this credential must never be a writer.
VITE_CLICKHOUSE_USER=apex_ro
VITE_CLICKHOUSE_PASSWORD=

# "fixtures" serves the recorded gate run with no database at all.
# "clickhouse" queries live. "auto" tries ClickHouse and falls back.
VITE_DATA_SOURCE=auto
