# The Apex API (serve/). The console reads through it alone (D-api-only,
# 2026-10-19): the browser carries THIS token and no database credential, and
# the API decides what it may see. The token still ships to every visitor, so
# scope it per consumer and rotate it; what it cannot do is read a table
# nobody exposed a route for.
#
# Where the DEV SERVER forwards /v1. Server-side only — it never reaches the
# bundle, so the browser keeps calling /v1 relative and stays same-origin.
# This is the one you normally set.
VITE_APEX_API_PROXY_TARGET=http://127.0.0.1:8099

# An ABSOLUTE base for the browser to call directly, bypassing the proxy.
# Leave it EMPTY unless you mean it: setting it makes every request
# cross-origin, and the API sends no CORS header, so the browser blocks them.
VITE_APEX_API_URL=
VITE_APEX_API_TOKEN=

# "http" — the DEFAULT — reads through the Apex API; it probes /v1/health once
# at boot and renders "no store answered" when nothing answers, while a 401 is
# reported on screen. "fixtures" serves the recorded gate run with no store
# at all, only when asked for by name — never as a fallback.
VITE_DATA_SOURCE=http

# NOTE: everything above configures DEVELOPMENT — the Vite dev server and a
# plain `npm run build`. The production image is configured at CONTAINER START
# instead (DATA_SOURCE, APEX_API_UPSTREAM where nginx forwards /v1,
# APEX_API_TOKEN written into /config.js, and APEX_API_URL only for a
# deliberate cross-origin call), so no rebuild is needed to point one image at
# another API. See README — "Configure a deployment".
