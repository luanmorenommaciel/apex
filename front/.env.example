# ClickHouse HTTP interface. In dev the Vite proxy fronts this at /clickhouse
# so the browser never needs a CORS header from the database.
VITE_CLICKHOUSE_URL=http://127.0.0.1:8123
VITE_CLICKHOUSE_DB=apex

# Use a READ-ONLY ClickHouse user. See README — "Querying ClickHouse from the
# browser" — for why this credential must never be a writer.
VITE_CLICKHOUSE_USER=apex_ro
VITE_CLICKHOUSE_PASSWORD=

# The Apex API (serve/). With DATA_SOURCE=http the browser carries THIS token
# and no database credential at all — the API decides what it may see. The
# token still ships to every visitor, so scope it per consumer and rotate it;
# what it cannot do is read a table nobody exposed a route for.
#
# VITE_APEX_API_URL is the PROXY TARGET for the dev server, not the address the
# browser calls. Leave the console's own apiUrl unset and requests go to /v1
# relative, which Vite (here) and nginx (in the image) forward — the same
# same-origin arrangement /clickhouse uses, so the API needs no CORS header.
VITE_APEX_API_URL=http://127.0.0.1:8099
VITE_APEX_API_TOKEN=

# "fixtures" serves the recorded gate run with no database at all.
# "clickhouse" queries live. "http" goes through the Apex API and never
# touches ClickHouse — including on a 401, which is reported rather than
# quietly fallen back from. "auto" prefers the API when one is configured and
# answering, then tries ClickHouse, then falls back to fixtures.
VITE_DATA_SOURCE=auto

# NOTE: everything above configures DEVELOPMENT — the Vite dev server and a
# plain `npm run build`. The production image is configured at CONTAINER START
# instead (CLICKHOUSE_UPSTREAM, CLICKHOUSE_DB, CLICKHOUSE_USER,
# CLICKHOUSE_PASSWORD, DATA_SOURCE), so no rebuild is needed to point one image
# at another store. See README — "Configure a deployment".
