# Runtime artifacts (listener output, Spark local scratch)
out/*.jsonl
out/*.log
.ivy2/
*.pyc
__pycache__/

# r9d overhead/soak artifacts — checkpoint and evidence manifest; a reviewed
# manifest is committed explicitly with a `!` rule like the calibration JSONs.
out/r9d-*.json

# calibration run artifacts — regenerate with `make calibrate`.
# The two runs cited as shipping evidence are committed explicitly.
out/calibration-*.json
!out/calibration-20260728T193824Z.json
!out/calibration-20260728T194104Z.json

# Docker Compose file-based secrets (local dev credential values) — never commit
# the actual secret files, only the README explaining how to regenerate them.
secrets/*
!secrets/README.md
