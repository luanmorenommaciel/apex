# ─────────────────────────────────────────────────────────────────────────────
# Apex dev-env — pinned version quartet (T1)
# Golden rule (DEV.md pitfalls): hadoop-aws MUST equal the bundled Hadoop version.
# Spark 4.0.x → Hadoop 3.4.x (AWS SDK v2 bundle). Delta 4.0.x needs Hadoop 3.4 + JDK17 + Scala 2.13.
# ─────────────────────────────────────────────────────────────────────────────

# ── PRIMARY quartet (active) — Spark 4.x / Delta 4.x / Hadoop 3.4.x ──
SPARK_IMAGE=apache/spark:4.0.1-scala2.13-java17-python3-ubuntu
SPARK_VERSION=4.0.1
SCALA_BIN=2.13
HADOOP_AWS_VERSION=3.4.1
AWS_SDK_BUNDLE_VERSION=2.24.6
DELTA_VERSION=4.0.0

# ── FALLBACK quartet (swap in if the primary image/jars don't resolve) ──
# SPARK_IMAGE=apache/spark:3.5.6-scala2.12-java17-python3-ubuntu
# SPARK_VERSION=3.5.6
# SCALA_BIN=2.12
# HADOOP_AWS_VERSION=3.3.4
# AWS_SDK_BUNDLE_VERSION=1.12.262          # NOTE: fallback uses AWS SDK v1 (aws-java-sdk-bundle groupId)
# DELTA_VERSION=3.3.2

# ── Built image name ──
APEX_IMAGE=apex-spark:local

# ── Cluster sizing (keep SMALL so pathologies actually trigger — DEV.md pitfall) ──
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# ── Pinned image digests (captured 2026-07-21) — kills `:latest` non-determinism ──
# Fresh clones pull the EXACT same MinIO/mc build. mc-based healthcheck depends on the
# `mc` binary being present, so pinning also locks that guarantee.
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

# ── MinIO / S3A ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
WAREHOUSE_BUCKET=warehouse
LOGS_BUCKET=spark-logs

# ── HOST port mappings (container-internal ports are unchanged) ──
# Other lanes run in parallel on this host. MinIO's S3 API is shifted off 9000
# because the collect/infra ClickHouse already publishes host :9000 (native proto).
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9001
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_HISTORY_PORT=18080

# ── Telemetry sink (collect lane optional; plugin export is fail-safe when absent) ──
APEX_OTLP_ENDPOINT=http://collect:4318
