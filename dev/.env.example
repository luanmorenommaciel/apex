# ─────────────────────────────────────────────────────────────────────────────
# Apex dev-env — pinned version quartet (T1)
# Golden rule (DEV.md pitfalls): hadoop-aws MUST equal the bundled Hadoop version.
# Spark 4.0.x → Hadoop 3.4.x (AWS SDK v2 bundle). Delta 4.0.x needs Hadoop 3.4 + JDK17 + Scala 2.13.
# ─────────────────────────────────────────────────────────────────────────────

# ── PRIMARY quartet (active) — Spark 4.x / Delta 4.x / Hadoop 3.4.x ──
SPARK_IMAGE=apache/spark:4.0.1-scala2.13-java17-python3-ubuntu
SPARK_VERSION=4.0.1
SCALA_BIN=2.13
HADOOP_AWS_VERSION=3.4.1
AWS_SDK_BUNDLE_VERSION=2.24.6
DELTA_VERSION=4.0.0

# ── FALLBACK quartet (swap in if the primary image/jars don't resolve) ──
# SPARK_IMAGE=apache/spark:3.5.6-scala2.12-java17-python3-ubuntu
# SPARK_VERSION=3.5.6
# SCALA_BIN=2.12
# HADOOP_AWS_VERSION=3.3.4
# AWS_SDK_BUNDLE_VERSION=1.12.262          # NOTE: fallback uses AWS SDK v1 (aws-java-sdk-bundle groupId)
# DELTA_VERSION=3.3.2

# ── Built image name ──
APEX_IMAGE=apex-spark:local

# ── Cluster sizing ──
# 8 cores = shipping default; 6 is the measured minimum (2026-07-28). verify's
# closed form: the skew stage is tail-bound iff p99/p50 > (n_tasks-1)/(slots-1).
# At n=100 partitions and two ~25% hot keys the lab measures p99/p50 = 22-28x, so
# 6 slots (threshold 19.8) passes with only ~1.1x margin and 8 slots
# (threshold 14.1) passes with ~1.5-2x. 2 slots can NEVER satisfy the closed
# form (the duration ratio is bounded by the bytes ratio n-1); 4 slots fails
# once the plugin's interpolated p99 is the statistic. Memory stays 2g so
# per-slot memory still starves the spill/driver_oom mechanisms (DEV.md pitfall).
SPARK_WORKER_CORES=8
SPARK_WORKER_MEMORY=2g

# ── Pinned image digests (captured 2026-10-22) — kills `:latest` non-determinism ──
# The local S3 store is RustFS (minio/minio and minio/mc can no longer be pulled);
# buckets are created with the AWS CLI. The same pins are the compose defaults, so an
# older .env that still names the MinIO images cannot bring them back.
RUSTFS_IMAGE=rustfs/rustfs:1.0.3@sha256:9ca9559533b537d10482fe923288b676ad08f92a7069d9a17327fbae3cab688b
S3_INIT_IMAGE=amazon/aws-cli:2.38.5@sha256:c8156a0e74e13929a42d7e60f0d4e14e7d28d980cd21822505d4bff80e5460c1

# ── Local S3 store (RustFS behind service name `minio`) / S3A ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
WAREHOUSE_BUCKET=warehouse
LOGS_BUCKET=spark-logs

# ── HOST port mappings (container-internal ports are unchanged) ──
# Other lanes run in parallel on this host. MinIO's S3 API is shifted off 9000
# because the collect/infra ClickHouse already publishes host :9000 (native proto).
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9001
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_HISTORY_PORT=18080

# ── Telemetry sink (collect lane optional; plugin export is fail-safe when absent) ──
APEX_OTLP_ENDPOINT=http://collect:4318
