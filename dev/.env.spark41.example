# Additive Spark 4.1.2 JAR/image compatibility cell. Do not replace dev/.env.
SPARK_IMAGE=apache/spark:4.1.2-scala2.13-java17-python3-ubuntu
SPARK_VERSION=4.1.2
SCALA_BIN=2.13
HADOOP_AWS_VERSION=3.4.2
AWS_SDK_BUNDLE_VERSION=2.24.6
DELTA_VERSION=4.1.0
DELTA_ARTIFACT=delta-spark_4.1_2.13
APEX_JAR_TARGET=apex_41
APEX_IMAGE=apex-spark:4.1.2-local

# Isolated host-port band so Spark 4.0.1 can remain running during this cell.
MINIO_API_PORT=19100
MINIO_CONSOLE_PORT=19001
SPARK_MASTER_UI_PORT=18081
SPARK_MASTER_PORT=17077
SPARK_HISTORY_PORT=28080
