        "kind": "empty-overlay",
        "entries": []
      }
    },
    {
      "name": "empty object with inner whitespace",
      "input": "{ \n }",
      "expected": {
        "kind": "empty-overlay",
        "entries": []
      }
    },
    {
      "name": "empty string",
      "input": "",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "whitespace only",
      "input": " \u00a0\ufeff\n",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "not json",
      "input": "{not json",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "array",
      "input": "[]",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "string scalar",
      "input": "\"x\"",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "canonical two keys",
      "input": "{\"spark.sql.adaptive.enabled\": \"true\", \"spark.sql.shuffle.partitions\": \"800\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "spark.sql.adaptive.enabled",
            "true"
          ],
          [
            "spark.sql.shuffle.partitions",
            "800"
          ]
        ]
      }
    },
    {
      "name": "unsorted input order is presented sorted",
      "input": "{\"spark.z\": \"1\", \"spark.m\": \"2\", \"spark.a\": \"3\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "spark.a",
            "3"
          ],
          [
            "spark.m",
            "2"
          ],
          [
            "spark.z",
            "1"
          ]
        ]
      }
    },
    {
      "name": "integer-like keys sort as strings, not first",
      "input": "{\"spark.a\": \"x\", \"10\": \"a\", \"9\": \"b\", \"2\": \"c\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "10",
            "a"
          ],
          [
            "2",
            "c"
          ],
          [
            "9",
            "b"
          ],
          [
            "spark.a",
            "x"
          ]
        ]
      }
    },
    {
      "name": "mixed case sorts by code point (upper before lower)",
      "input": "{\"spark.b\": \"1\", \"Spark.B\": \"2\", \"spark.B\": \"3\", \"SPARK.a\": \"4\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "SPARK.a",
            "4"
          ],
          [
            "Spark.B",
            "2"
          ],
          [
            "spark.B",
            "3"
          ],
          [
            "spark.b",
            "1"
          ]
        ]
      }
    },
    {
      "name": "astral key sorts after high-BMP key (code point, not UTF-16 unit)",
      "input": "{\"\ud83d\ude00\": \"astral\", \"\uffff\": \"bmp\", \"a\": \"ascii\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "a",
            "ascii"
          ],
          [
            "\uffff",
            "bmp"
          ],
          [
            "\ud83d\ude00",
            "astral"
          ]
        ]
      }
    },
    {
      "name": "astral vs U+E000 private-use",
      "input": "{\"\ue000\": \"pua\", \"\ud83d\ude00\": \"astral\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "\ue000",
            "pua"
          ],
          [
            "\ud83d\ude00",
            "astral"
          ]
        ]
      }
    },
    {
      "name": "duplicate keys: last value wins",
      "input": "{\"spark.a\": \"1\", \"spark.b\": \"2\", \"spark.a\": \"3\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "spark.a",
            "3"
          ],
          [
            "spark.b",
            "2"
          ]
        ]
      }
    },
    {
      "name": "scalars stringified like String()",
      "input": "{\"spark.b\": true, \"spark.a\": 5, \"spark.c\": 0.7, \"spark.d\": 1.0, \"spark.e\": false}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "spark.a",
            "5"
          ],
          [
            "spark.b",
            "true"
          ],
          [
            "spark.c",
            "0.7"
          ],
          [
            "spark.d",
            "1"
          ],
          [
            "spark.e",
            "false"
          ]
        ]
      }
    },
    {
      "name": "1e400 overflows",
      "input": "{\"spark.a\": 1e400}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "-1e400 overflows",
      "input": "{\"spark.a\": -1e400}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "9007199254740993 beyond MAX_SAFE_INTEGER",
      "input": "{\"spark.a\": 9007199254740993}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "-9007199254740993 beyond MAX_SAFE_INTEGER",
      "input": "{\"spark.a\": -9007199254740993}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "9007199254740991 is MAX_SAFE_INTEGER",
      "input": "{\"spark.a\": 9007199254740991}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "spark.a",
            "9007199254740991"
          ]
        ]
      }
    },
    {
      "name": "-9007199254740991",
      "input": "{\"spark.a\": -9007199254740991}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "spark.a",
            "-9007199254740991"
          ]
        ]
      }
    },
    {
      "name": "NaN literal",
      "input": "{\"spark.a\": NaN}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "Infinity literal",
      "input": "{\"spark.a\": Infinity}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "-Infinity literal",
      "input": "{\"spark.a\": -Infinity}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "null member",
      "input": "{\"spark.a\": null}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "nested object member",
      "input": "{\"spark.a\": {\"b\": \"c\"}}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "array member",
      "input": "{\"spark.a\": [\"1\"]}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "one bad member invalidates the whole overlay",
      "input": "{\"spark.a\": \"1\", \"spark.b\": null}",
      "expected": {
        "kind": "none",
        "entries": []
      }
    },
    {
      "name": "lone high-surrogate key (JSON escape)",
      "input": "{\"\\ud800\": \"x\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "\ud800",
            "x"
          ]
        ]
      }
    },
    {
      "name": "reversed surrogate pair key is two lone surrogates",
      "input": "{\"\\ude00\\ud83d\": \"x\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "\ude00\ud83d",
            "x"
          ]
        ]
      }
    },
    {
      "name": "lone surrogates order against astral, high-BMP and ASCII keys (code point)",
      "input": "{\"\\ud83d\\ude00\": \"astral\", \"\\uffff\": \"bmp\", \"\\ude00\\ud83d\": \"low-high\", \"\\ud800\": \"high\", \"a\": \"ascii\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "a",
            "ascii"
          ],
          [
            "\ud800",
            "high"
          ],
          [
            "\ude00\ud83d",
            "low-high"
          ],
          [
            "\uffff",
            "bmp"
          ],
          [
            "\ud83d\ude00",
            "astral"
          ]
        ]
      }
    },
    {
      "name": "__proto__ key is an ordinary member",
      "input": "{\"spark.a\": \"1\", \"__proto__\": \"x\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "__proto__",
            "x"
          ],
          [
            "spark.a",
            "1"
          ]
        ]
      }
    },
    {
      "name": "empty-string key",
      "input": "{\"a\": \"1\", \"\": \"v\"}",
      "expected": {
        "kind": "overlay",
        "entries": [
          [
            "",
            "v"
          ],
          [
            "a",
            "1"
          ]
        ]
      }
    },
    {
      "name": "a valid unified diff is not an overlay",
      "input": "--- a/conf/spark-defaults.conf\n+++ b/conf/spark-defaults.conf\n@@ -1 +1 @@\n-spark.sql.shuffle.partitions 200\n+spark.sql.shuffle.partitions 800\n",
      "expected": {
        "kind": "none",
        "entries": []
      }
    }
  ]
}
