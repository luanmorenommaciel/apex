name: apex-official
services:
  clickhouse:
    container_name: apex-clickhouse
    environment:
      CLICKHOUSE_DB: apex
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: "1"
      CLICKHOUSE_PASSWORD: spv0
      CLICKHOUSE_USER: spv0
    healthcheck:
      test:
        - CMD
        - clickhouse-client
        - --user
        - spv0
        - --password
        - spv0
        - --query
        - SELECT 1
      timeout: 3s
      interval: 5s
      retries: 20
    image: spark-plat-v0-clickhouse:26.5.1
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8123
        published: "28123"
        protocol: tcp
      - mode: ingress
        target: 9000
        published: "9000"
        protocol: tcp
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - type: volume
        source: apex_clickhouse_data
        target: /var/lib/clickhouse
        volume: {}
      - type: bind
        source: C:\Users\Guest\Documents\project\codex\apex\apex-official\docs\specs\apex_telemetry_v1.sql
        target: /docker-entrypoint-initdb.d/001-apex-telemetry-v1.sql
        read_only: true
        bind: {}
  minio:
    command:
      - server
      - /data
      - --console-address
      - :9001
    container_name: apex-minio
    environment:
      MINIO_ROOT_PASSWORD: spv0spv0
      MINIO_ROOT_USER: spv0
    healthcheck:
      test:
        - CMD-SHELL
        - curl -f http://localhost:9000/minio/health/ready || exit 1
      timeout: 3s
      interval: 5s
      retries: 20
    image: spark-plat-v0-minio:2025-09-07
    networks:
      default: null
    ports:
      - mode: ingress
        target: 9000
        published: "29000"
        protocol: tcp
      - mode: ingress
        target: 9001
        published: "29001"
        protocol: tcp
    volumes:
      - type: volume
        source: apex_minio_data
        target: /data
        volume: {}
  minio-init:
    container_name: apex-minio-init
    depends_on:
      minio:
        condition: service_healthy
        required: true
    environment:
      MINIO_LAKEHOUSE_BUCKET: lakehouse
      MINIO_LOG_BUCKET: spark-logs
      MINIO_ROOT_PASSWORD: spv0spv0
      MINIO_ROOT_USER: spv0
    image: spark-plat-v0-minio-mc:2025-08-13
    networks:
      default: null
  spark-master:
    command:
      - /opt/spark/bin/spark-class
      - org.apache.spark.deploy.master.Master
      - --host
      - spark-master
      - --port
      - "7077"
      - --webui-port
      - "8080"
    container_name: apex-spark-master
    depends_on:
      minio-init:
        condition: service_completed_successfully
        required: true
    environment:
      SPARK_MASTER_HOST: spark-master
      SPARK_NO_DAEMONIZE: "true"
    image: spark-plat-v0-spark:4.1.2
    networks:
      default: null
    ports:
      - mode: ingress
        target: 7077
        published: "7077"
        protocol: tcp
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Guest\Documents\project\codex\apex\apex-official\docker\spark\spark-defaults.conf
        target: /opt/spark/conf/spark-defaults.conf
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\Guest\Documents\project\codex\apex\apex-official\listener-jvm\build\libs\apex-spark-listener-0.1.0.jar
        target: /opt/apex/listener/apex-spark-listener-0.1.0.jar
        read_only: true
        bind: {}
      - type: volume
        source: apex_spark_event_logs
        target: /tmp/spark-events
        volume: {}
  spark-worker:
    command:
      - /opt/spark/bin/spark-class
      - org.apache.spark.deploy.worker.Worker
      - --cores
      - "8"
      - --memory
      - 4g
      - spark://spark-master:7077
    container_name: apex-spark-worker
    depends_on:
      spark-master:
        condition: service_started
        required: true
    environment:
      SPARK_MASTER_URL: spark://spark-master:7077
      SPARK_NO_DAEMONIZE: "true"
      SPARK_WORKER_CORES: "8"
      SPARK_WORKER_MEMORY: 4G
    image: spark-plat-v0-spark:4.1.2
    networks:
      default: null
    volumes:
      - type: bind
        source: C:\Users\Guest\Documents\project\codex\apex\apex-official\docker\spark\spark-defaults.conf
        target: /opt/spark/conf/spark-defaults.conf
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\Guest\Documents\project\codex\apex\apex-official\listener-jvm\build\libs\apex-spark-listener-0.1.0.jar
        target: /opt/apex/listener/apex-spark-listener-0.1.0.jar
        read_only: true
        bind: {}
      - type: volume
        source: apex_spark_event_logs
        target: /tmp/spark-events
        volume: {}
networks:
  default:
    name: apex-official_default
volumes:
  apex_clickhouse_data:
    name: apex-official_apex_clickhouse_data
  apex_minio_data:
    name: apex-official_apex_minio_data
  apex_spark_event_logs:
    name: apex-official_apex_spark_event_logs
